{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "1o application typed service binding declaration v1",
  "type": "object",
  "properties": {
    "application_service": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "contract": {"type": "string"},
        "service": {"type": "string", "x-1o-semantic-ref": "nodeplan.service"},
        "binding": {"type": "string", "enum": ["local_uds", "remote_nodeplan"]}
      },
      "required": ["name", "contract", "service", "binding"]
    }
  },
  "required": ["application_service"]
}
