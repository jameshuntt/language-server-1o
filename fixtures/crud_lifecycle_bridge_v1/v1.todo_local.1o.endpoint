{
    endpoint {
        name "todo_local"
        service "type_serverd"

        route {
            method "POST"
            path "/todos"
            operation "todo.create"
        }

        route {
            method "GET"
            path "/todos/:id"
            operation "todo.read"
        }

        route {
            method "PATCH"
            path "/todos/:id"
            operation "todo.update"
        }

        route {
            method "DELETE"
            path "/todos/:id"
            operation "todo.delete"
        }
    }
}
